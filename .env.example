APP_NAME=Education Platform API
APP_VERSION=0.1.0
APP_DEBUG=false
APP_LOG_LEVEL=INFO

POSTGRES_USER=education_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=education_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CLASSROOM_CACHE_TTL_SECONDS=300
# REDIS_PASSWORD=replace_if_authentication_is_enabled

JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
